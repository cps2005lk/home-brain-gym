# Copy this file to .env.local and paste your own values.
# .env.local is never committed (see .gitignore).
#
# Vite only passes variables starting with VITE_ to the browser.
#
# The publishable key (sb_publishable_...) is meant to be public: it only says
# which project a request belongs to. What it may actually read or write is
# decided by the Row Level Security policies in the database.
#
# NEVER put the secret key (sb_secret_...) in this app. That one is for servers
# only and it ignores Row Level Security.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
