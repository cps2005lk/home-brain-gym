# Copy this file to .env.local and paste your own values.
# .env.local is never committed (see .gitignore).
#
# Vite only passes variables starting with VITE_ to the browser.
# Both of these are meant to be public: the anon key only works together with
# the Row Level Security policies, which decide what each signed-in parent sees.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
